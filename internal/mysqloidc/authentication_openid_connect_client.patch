diff --git a/auth.go b/auth.go
--- a/auth.go
+++ b/auth.go
@@ -276,4 +276,30 @@ func (mc *mysqlConn) auth(authData []byte, plugin string) ([]byte, error) {
 	switch plugin {
+	case "authentication_openid_connect_client":
+		// MySQL's OIDC client plugin sends a capability byte followed by a
+		// length-encoded JWT. Keep this implementation intentionally strict:
+		// a token must never cross an unencrypted TCP connection and must not
+		// silently fall back to a password authentication plugin.
+		if mc.cfg.TLS == nil && mc.cfg.Net != "unix" {
+			return nil, fmt.Errorf("authentication_openid_connect_client requires TLS")
+		}
+		if !mc.cfg.OIDCEnabled || mc.cfg.OIDCTokenProvider == nil {
+			return nil, fmt.Errorf("OpenID Connect token provider is not configured")
+		}
+		token, err := mc.cfg.OIDCTokenProvider()
+		if err != nil {
+			return nil, fmt.Errorf("get OpenID Connect identity token: %w", err)
+		}
+		if len(token) == 0 || len(token) > 10_000 {
+			return nil, fmt.Errorf("invalid OpenID Connect identity token")
+		}
+		// Doris accepts this payload in its initial handshake while Oracle
+		// MySQL can request the same payload through AuthSwitchRequest. The
+		// caller invokes auth for both states, so JWT delivery is identical.
+		response := []byte{1}
+		response = appendLengthEncodedInteger(response, uint64(len(token)))
+		response = append(response, []byte(token)...)
+		return response, nil
+
 	case "caching_sha2_password":
 		authResp := scrambleSHA256Password(authData, mc.cfg.Passwd)
 		return authResp, nil
